# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password123@postgres:5432/whatsapp_relationship_ai

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-in-production-min-32-chars!!
JWT_EXPIRES_IN=7d

# ── Encryption ───────────────────────────────────────────────────────────────
SESSION_ENCRYPTION_KEY=change-this-32-char-key!!seskey
SETTINGS_ENCRYPTION_KEY=change-this-32-char-enc-key-now!!

# ── AI (Groq — FREE tier, best for production) ────────────────────────────────
# Get key from: https://console.groq.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# Vision (for image status analysis)
GROQ_API_KEY=
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── Meta WhatsApp Cloud API ───────────────────────────────────────────────────
# Surely Production Number: +91 74996 19490
# Get permanent token from: business.facebook.com → System Users → Generate Token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1106935729175574
WHATSAPP_WABA_ID=1544033387077834
WHATSAPP_VERIFY_TOKEN=

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── WhatsApp Web (Baileys fallback) ───────────────────────────────────────────
WA_HEADLESS=true

# PHP Admin Panel API Key
ADMIN_API_KEY=change-this-secure-admin-key-123
