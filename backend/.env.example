# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@postgres:5432/whatsapp_relationship_ai

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-minimum-32-char-jwt-secret-here
JWT_EXPIRES_IN=7d

# ── Encryption ───────────────────────────────────────────────────────────────
SESSION_ENCRYPTION_KEY=your-32-char-session-encryption-key
SETTINGS_ENCRYPTION_KEY=your-32-char-settings-encryption-key

# ── AI ────────────────────────────────────────────────────────────────────────
# Option A: Groq (FREE) — https://console.groq.com
OPENAI_API_KEY=gsk_your_groq_api_key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# Option B: OpenAI (Paid)
# OPENAI_API_KEY=sk-your_openai_key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Vision model for image status analysis (Groq free tier)
GROQ_API_KEY=gsk_your_groq_api_key
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── Meta WhatsApp Cloud API ───────────────────────────────────────────────────
#
# HOW TO GET YOUR CREDENTIALS:
#   1. Go to developers.facebook.com → Your App → WhatsApp → API Setup
#   2. Copy Phone Number ID and WABA ID from the setup page
#
# HOW TO GET PERMANENT ACCESS TOKEN:
#   1. Go to business.facebook.com
#   2. Settings → System Users → Add System User (Admin)
#   3. Generate New Token → select your WhatsApp app
#   4. Permissions: whatsapp_business_messaging + whatsapp_business_management
#   5. Copy token — it never expires
#
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_from_meta
WHATSAPP_WABA_ID=your_waba_id_from_meta
WHATSAPP_VERIFY_TOKEN=your_random_webhook_verify_token

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── WhatsApp Web (Baileys) ────────────────────────────────────────────────────
WA_HEADLESS=true
